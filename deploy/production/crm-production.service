[Unit]
Description=AI WhatsApp Agent CRM - produccion
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
# Usuario de sistema propio, sin shell y sin sudo (brief-13.1, diferencia D-2 del README).
# En staging la aplicacion corre como el usuario del ssh, que tiene sudo: con datos reales,
# un proceso comprometido no puede heredar un camino a root.
User=crm
Group=crm
WorkingDirectory=/srv/crm-production
# Secretos fuera del repositorio, 0600 de root (brief-13.1, D-5). systemd lo lee como
# root antes de bajar a User=crm, asi que el usuario de la app nunca puede leerlo.
EnvironmentFile=/etc/crm-production/app.env
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5

# Endurecimiento: la aplicacion no necesita nada de esto.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/crm-production/.next
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
