[Unit]
Description=AI WhatsApp Agent CRM - backup logico de staging
Documentation=file:///srv/crm-staging/docs/runbooks/restaurar-la-base.md
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# Corre como root porque tiene que leer /etc/crm-staging/backup.env y el .pgpass del
# rol dueno, los dos 0600 de root (brief-9.2, D-4). El endurecimiento de abajo acota
# lo que puede hacer con eso: sin red externa, sin privilegios nuevos, y con el
# sistema de archivos de solo lectura salvo el directorio de copias.
User=root
Group=root
ExecStart=/usr/local/bin/crm-backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/crm-staging
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# La base es local: el backup no tiene por que hablar con nadie de afuera.
IPAddressAllow=localhost
IPAddressDeny=any
