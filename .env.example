# Valores de ejemplo SOLO para desarrollo local. Copiar a .env (ignorado por Git).
# Nunca poner acá credenciales de otro entorno.

# Contenedor de docker-compose.yml
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_dev
POSTGRES_DB=crm_dev

# Aplicación, tests de integración y Drizzle Kit
DATABASE_URL=postgresql://crm:crm_local_dev@127.0.0.1:5432/crm_dev
