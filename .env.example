# Valores de ejemplo SOLO para desarrollo local. Copiar a .env (ignorado por Git).
# Nunca poner acá credenciales de otro entorno.

# Contenedor de docker-compose.yml
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_dev
POSTGRES_DB=crm_dev

# Aplicación, tests de integración y Drizzle Kit
DATABASE_URL=postgresql://crm:crm_local_dev@127.0.0.1:5432/crm_dev

# Límite de intentos por IP (brief-3.3, D-4). "true" SOLO detrás de un proxy propio y con
# UN SOLO salto: la aplicación lee la última entrada de x-forwarded-for, así que con dos
# proxies esa entrada deja de ser la IP del cliente y todas las peticiones vuelven a
# compartir clave (H-3). Sin proxy, dejar en false.
#
# En staging el proxy REEMPLAZA la cabecera con la IP que vio, en vez de agregarla a la
# cadena (brief-9.1, D-9): así no hay entrada falsificable. Las dos formas funcionan con un
# solo salto; reemplazar quita la superficie. Ver deploy/staging/.
TRUSTED_PROXY=false

# Contraseña sintética de los usuarios de npm run db:seed (brief-3.5, D-7). Solo desarrollo local.
SEED_USER_PASSWORD=semilla-local-crm-2026

# Endpoint de ingestión (brief-6.5.3, D-4). Apagado por defecto: responde 404.
# Encendido, solo acepta las credenciales listadas (ids separados por comas, creados con
# npm run ingestion:credential). Nunca listar acá credenciales de un emisor real.
INGESTION_ENABLED=false
INGESTION_ALLOWED_CREDENTIALS=

